{
  "name": "catalog-management-agent",
  "version": "1.0.0",
  "description": "Autonomous catalog management agent for product classification, tagging, and data quality",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node src/db/seed.ts"
  },
  "keywords": [
    "catalog",
    "agent",
    "ai",
    "classification",
    "tagging",
    "product-management"
  ],
  "author": "Catalog Management Team",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.25.1",
    "@google/generative-ai": "^0.11.0",
    "@prisma/client": "^5.7.0",
    "amqplib": "^0.10.3",
    "axios": "^1.6.5",
    "bull": "^4.11.5",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fastify": "^4.26.0",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "kafkajs": "^2.2.4",
    "langchain": "^0.1.21",
    "node-fetch": "^2.7.0",
    "openai": "^4.26.1",
    "pg": "^8.11.3",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "prisma": "^5.7.0",
    "redis": "^4.6.12",
    "socket.io": "^4.7.2",
    "typescript": "^5.3.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@testing-library/react": "^14.1.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "directories": {
    "lib": "src",
    "test": "tests",
    "doc": "docs"
  }
}
